# ============================================================
# APMC Vashi Market Price System — Environment Variables
# ============================================================
# 1. For local dev: copy this file to .env.local and fill in your values
# 2. For Vercel: go to Project → Settings → Environment Variables and add these
#
# The app works WITHOUT Supabase using local seed data.
# Only add these if you want a live database.
# ============================================================

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
